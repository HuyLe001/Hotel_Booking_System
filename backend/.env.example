# ========================================================
# TEMPLATE BIẾN MÔI TRƯỜNG (.env.example)
# Hãy copy file này thành .env và điền các thông tin thực tế
# ========================================================

# Chuỗi kết nối đến PostgreSQL (Supabase / Local)
DATABASE_URL="Host=localhost;Port=5432;Database=hotel_db;Username=postgres;Password=your_password;SSL Mode=Prefer;"

# Cấu hình JWT Token (Key tối thiểu 32 ký tự)
Jwt__Key="YourSuperSecretKeyMustBeAtLeast32CharsLong!"
Jwt__Issuer="HotelBookingAPI"
Jwt__Audience="HotelBookingClient"
Jwt__ExpireMinutes="60"
